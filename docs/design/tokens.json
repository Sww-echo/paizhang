    { "fg": "subtle", "bg": ["bg", "surface"] },
    { "fg": "brand", "bg": ["bg", "surface", "sunken"] },
    { "fg": "brandInk", "bg": ["bg", "surface"] },
    { "fg": "onBrand", "bg": ["brand"] },
    { "fg": "win", "bg": ["bg", "surface"] },
    { "fg": "lose", "bg": ["bg", "surface"] },
    { "fg": "warn", "bg": ["bg", "surface"] },
    { "fg": "heroInk", "bg": ["hero"] },
    { "fg": "heroSub", "bg": ["hero"] },
    { "fg": "tintInk", "bg": ["tint"] },
    { "fg": "winInk", "bg": ["winTint"] },
    { "fg": "loseInk", "bg": ["loseTint"] },
    { "fg": "warnInk", "bg": ["warnTint"] },
    { "fg": "focus", "bg": ["bg", "surface"] }
