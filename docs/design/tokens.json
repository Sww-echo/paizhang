        { "dx": 3, "dy": 3, "blur": 7, "spread": 0, "color": "#080C0B", "blurStyle": "normal" },
        { "dx": -3, "dy": -3, "blur": 7, "spread": 0, "color": "#FFFFFF14", "blurStyle": "normal" }
