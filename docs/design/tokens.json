  "radius": { "chip": 999, "xs": 12, "sm": 16, "md": 20, "lg": 28, "xl": 32 },
  "space": { "x1": 4, "x2": 8, "x3": 12, "x4": 16, "x5": 20, "x6": 24, "x8": 32, "page": 20, "card": 16, "gap": 16, "rowMin": 56, "rowTight": 52, "tapMin": 44 },
  "type": {
    "heroValue": { "size": 40, "lineHeight": 44, "weight": 800, "mono": true },
    "display": { "size": 40, "lineHeight": 46, "weight": 700, "mono": true },
    "h1": { "size": 26, "lineHeight": 33, "weight": 800 },
    "h2": { "size": 18, "lineHeight": 24, "weight": 800 },
    "body": { "size": 15, "lineHeight": 22, "weight": 500 },
    "bodySm": { "size": 13.5, "lineHeight": 20, "weight": 500 },
    "label": { "size": 11.5, "lineHeight": 16, "weight": 700, "trackingEm": 0.06 },
    "meta": { "size": 11.5, "lineHeight": 16, "weight": 500 }
  },
  "mono": { "letterSpacing": -0.2, "fontFeatures": ["tabularFigures"], "minusSign": "\u2212" },
  "size": { "buttonH": 52, "buttonGH": 44, "chipH": 38, "segmentedH": 36, "inputH": 56, "amountH": 72, "avatar": 32, "avatarLg": 40, "meterH": 16, "pillH": 20, "dialogW": 320, "toastH": 48 },
  "motion": {
    "press": { "ms": 120, "curve": "easeOutQuad", "scale": 0.98 },
    "select": { "ms": 180, "curve": "easeOutCubic" },
    "cardIn": { "ms": 240, "curve": "easeOutCubic", "offsetY": 12, "staggerMs": 40, "staggerMax": 6 },
    "page": { "ms": 240, "curve": "easeInOutCubic" },
    "sheet": { "ms": 320, "curve": "cubic(0.2,0,0,1)" },
    "number": { "ms": 220, "curve": "easeOutCubic" },
    "focus": { "ms": 180, "curve": "easeOutCubic" },
    "success": { "ms": 240, "curve": "easeOutBack" }
  }
}
